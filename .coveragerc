# Coverage is measured over app/ only. tests/, migrations/ and the scratch
# scripts at the repo root are not production code.
[run]
source = app
branch = True
omit =
    */__init__.py

[report]
show_missing = True
skip_covered = False
exclude_lines =
    pragma: no cover
    if TYPE_CHECKING:
    raise NotImplementedError
    @abstractmethod

# Enforced by `coverage report`, so the floor applies whether it is invoked by
# pytest.ini, by CI, or by hand. Current measurement is 86% (branch=True).
# The floor sits a few points below the real number on purpose: a floor set at
# exactly the current figure turns every unrelated change into a coverage
# failure and gets ignored. Raise it as the intake/integrations gaps close.
fail_under = 82

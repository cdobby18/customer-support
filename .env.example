DATABASE_URL=postgresql+psycopg://support_user:support_password@localhost:5432/support_db
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE_MINUTES=60
# Access-token claims. `iss`/`aud` stop a token minted for another service that
# shares the secret from being replayed against this API.
JWT_ISSUER=ai-customer-support
JWT_AUDIENCE=ai-customer-support-api
# Login brute-force throttling: per email + client IP, a sliding window of
# failed attempts. Once the limit is hit the pair is refused with 429 and a
# Retry-After header for the lockout window. A successful login clears it.
# 0 or less disables throttling; production refuses to boot with it disabled.
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_LOCKOUT_SECONDS=300
# Public self-service registration. Set AUTH_REGISTRATION_ENABLED=0 for an
# invite-only deployment (POST /auth/register then answers 403).
# AUTH_REGISTER_MAX_ATTEMPTS bounds registrations per client IP within
# AUTH_LOGIN_LOCKOUT_SECONDS; 0 disables the registration throttle.
AUTH_REGISTRATION_ENABLED=1
AUTH_REGISTER_MAX_ATTEMPTS=20
# Where rate-limit windows live. `memory` is per-process, so N replicas each
# allow the full limit; set `redis` to make the limit cluster-wide (falls back
# to memory if Redis is unreachable). Applies to login, registration,
# inbound webhooks and the LLM gateway.
RATE_LIMIT_BACKEND=memory
CHANNEL_WEBHOOK_SECRET=replace-with-a-long-webhook-secret
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRUSTED_HOSTS=localhost,127.0.0.1
WEBHOOK_RATE_LIMIT_PER_MINUTE=60

# Outbound CRM/helpdesk sync. Leave unset or "none" to disable.
# Set to "mock" for a credential-free provider (dev/demo/tests).
# Set to "zendesk" or "hubspot" when API credentials are available.
SUPPORT_TOOL_PROVIDER=mock

# Zendesk provider (required when SUPPORT_TOOL_PROVIDER=zendesk)
ZENDESK_SUBDOMAIN=your-subdomain
ZENDESK_API_EMAIL=agent@example.com
ZENDESK_API_TOKEN=replace-with-zendesk-api-token

# HubSpot provider (required when SUPPORT_TOOL_PROVIDER=hubspot)
HUBSPOT_ACCESS_TOKEN=replace-with-hubspot-private-app-token

# Observability. Enable OpenTelemetry tracing; spans are exported via OTLP/HTTP
# to OTEL_EXPORTER_OTLP_ENDPOINT (defaults to http://localhost:4318/v1/traces).
OTEL_ENABLED=0
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
LOG_LEVEL=INFO

# Audit compliance: purge audit logs older than this many days via
# POST /admin/audit-logs/purge.
AUDIT_LOG_RETENTION_DAYS=365

# LLM gateway. Leave unset to disable the gateway (no AI agents active).
# Set to "mock" for a credential-free deterministic provider (dev/demo/tests).
# Set to "openai" or "azure_openai" when API credentials are available.
# Production refuses to boot with LLM_PROVIDER=mock.
LLM_PROVIDER=mock

# OpenAI provider (required when LLM_PROVIDER=openai)
OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Azure OpenAI provider (required when LLM_PROVIDER=azure_openai)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=your-deployment-name
AZURE_OPENAI_API_KEY=replace-with-azure-api-key
AZURE_OPENAI_API_VERSION=2024-10-21

# LLM gateway guardrails: process-local rate limit and retry budget.
LLM_RATE_LIMIT_PER_MINUTE=60
LLM_MAX_RETRIES=3

# Response Agent: drafts below this confidence go to human review.
RESPONSE_CONFIDENCE_THRESHOLD=0.75

# Guardrails. HIGH_VALUE_REFUND_MIN_USD is the refund amount above which the
# guardrail layer demands human review instead of letting a draft go out;
# ALLOWED_RESPONSE_DOMAINS is a comma-separated list of domains a drafted reply
# may link to. Empty means "no extra restriction".
# HIGH_VALUE_REFUND_MIN_USD=500
# ALLOWED_RESPONSE_DOMAINS=help.example.com,docs.example.com

# Ticket intake. BLOCKED_EMAIL_DOMAINS is a comma-separated list of email
# domains refused at signup. Empty means "allow every domain".
# BLOCKED_EMAIL_DOMAINS=spam.example,mailinator.com

# SLA deadlines, scaled per channel. JSON object of channel -> float, merged
# over the built-in defaults (slack 0.75, whatsapp/chat 0.5, everything else
# 1.0). Unparseable values are ignored in favour of the defaults.
# A higher multiplier means a LONGER window.
# SLA_CHANNEL_MULTIPLIERS={"slack": 0.5, "chat": 0.25}

# Ticket attachments. UPLOAD_DIR is where files are written; MAX_ATTACHMENT_BYTES
# is the per-file ceiling (default 5MB) and MAX_TICKET_ATTACHMENTS the per-ticket
# file count (default 5).
# UPLOAD_DIR=.uploads
# MAX_ATTACHMENT_BYTES=5242880
# MAX_TICKET_ATTACHMENTS=5

# Self-service automation: when enabled, new tickets are answered by the AI
# Response Agent automatically. Safe drafts are sent to the customer and the
# ticket resolved; anything uncertain is escalated to human review.
AUTO_RESPOND_ENABLED=false

# Semantic search embeddings. "local" uses sentence-transformers (no API key,
# default). "openai" uses the OpenAI embeddings API (text-embedding-3-small by
# default) for grounded RAG and requires OPENAI_API_KEY.
# EMBEDDING_MODEL defaults to all-MiniLM-L6-v2 for local, text-embedding-3-small
# for openai. Batch size only applies to the openai provider.
EMBEDDING_PROVIDER=local
# EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BATCH_SIZE=64
# Preload the local embedding model on a background thread at startup. The model
# takes ~1min to import, and without this the first knowledge search of a process
# pays for it, which reads as a hung "Generate AI draft" request.
# auto (default) = on in development, off under pytest and in production.
# Only ever affects the local provider; the openai provider needs no local model.
# EMBEDDING_WARMUP=auto

# Async job queue. REDIS_URL is the Celery broker and result backend.
# REDIS_URL=redis://localhost:6379/0
# 1 (the default) runs tasks inline in the request, so no broker is needed for
# local dev or the test suite. 0 requires a running worker
# (`celery -A app.core.workers worker --pool=solo`); production sets 0.
# CELERY_TASK_ALWAYS_EAGER=1

# Async outbound notifications. The `support.notify` Celery task POSTs
# {event, ticket_id, ...payload} to NOTIFY_WEBHOOK_URL. Payloads carry ticket
# PII, so the task sends an HMAC-SHA256 signature and refuses to send at all
# unless BOTH of these are set. The URL must be https:// (http:// is accepted
# only for loopback, so the local receiver below still works).
# Receivers verify X-Support-Signature: t=<unix>,v1=<hex> where
# v1 = HMAC-SHA256(NOTIFY_WEBHOOK_SECRET, "<t>." + exact body).
# Leave the URL unset to disable outbound notifications entirely.
# NOTIFY_WEBHOOK_URL=https://hooks.example.com/support
# NOTIFY_WEBHOOK_SECRET=replace-with-a-long-signing-secret
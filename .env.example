DATABASE_URL=postgresql+psycopg://support_user:support_password@localhost:5432/support_db
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE_MINUTES=60
CHANNEL_WEBHOOK_SECRET=replace-with-a-long-webhook-secret
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRUSTED_HOSTS=localhost,127.0.0.1
WEBHOOK_RATE_LIMIT_PER_MINUTE=60

# Outbound CRM/helpdesk sync. Leave unset or "none" to disable.
# Set to "mock" for a credential-free provider (dev/demo/tests).
# Set to "zendesk" or "hubspot" when API credentials are available.
SUPPORT_TOOL_PROVIDER=mock

# Zendesk provider (required when SUPPORT_TOOL_PROVIDER=zendesk)
ZENDESK_SUBDOMAIN=your-subdomain
ZENDESK_API_EMAIL=agent@example.com
ZENDESK_API_TOKEN=replace-with-zendesk-api-token

# HubSpot provider (required when SUPPORT_TOOL_PROVIDER=hubspot)
HUBSPOT_ACCESS_TOKEN=replace-with-hubspot-private-app-token

# Observability. Enable OpenTelemetry tracing; spans are exported via OTLP/HTTP
# to OTEL_EXPORTER_OTLP_ENDPOINT (defaults to http://localhost:4318/v1/traces).
OTEL_ENABLED=0
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
LOG_LEVEL=INFO

# Audit compliance: purge audit logs older than this many days via
# POST /admin/audit-logs/purge.
AUDIT_LOG_RETENTION_DAYS=365

# LLM gateway. Leave unset to disable the gateway (no AI agents active).
# Set to "mock" for a credential-free deterministic provider (dev/demo/tests).
# Set to "openai" or "azure_openai" when API credentials are available.
# Production refuses to boot with LLM_PROVIDER=mock.
LLM_PROVIDER=mock

# OpenAI provider (required when LLM_PROVIDER=openai)
OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Azure OpenAI provider (required when LLM_PROVIDER=azure_openai)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=your-deployment-name
AZURE_OPENAI_API_KEY=replace-with-azure-api-key
AZURE_OPENAI_API_VERSION=2024-10-21

# LLM gateway guardrails: process-local rate limit and retry budget.
LLM_RATE_LIMIT_PER_MINUTE=60
LLM_MAX_RETRIES=3

# Response Agent: drafts below this confidence go to human review.
RESPONSE_CONFIDENCE_THRESHOLD=0.75

# Self-service automation: when enabled, new tickets are answered by the AI
# Response Agent automatically. Safe drafts are sent to the customer and the
# ticket resolved; anything uncertain is escalated to human review.
AUTO_RESPOND_ENABLED=false

# Semantic search embeddings. "local" uses sentence-transformers (no API key,
# default). "openai" uses the OpenAI embeddings API (text-embedding-3-small by
# default) for grounded RAG and requires OPENAI_API_KEY.
# EMBEDDING_MODEL defaults to all-MiniLM-L6-v2 for local, text-embedding-3-small
# for openai. Batch size only applies to the openai provider.
EMBEDDING_PROVIDER=local
# EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BATCH_SIZE=64
__pycache__/
.pytest_cache/
.venv/

# Coverage artifacts
.coverage
.coverage.*
coverage.xml
htmlcov/

# Throwaway SQLite file used by the CI e2e job
.ci-e2e.db

support.db
frontend/node_modules/
frontend/dist/
frontend/playwright-report/
frontend/test-results/

.vscode/

# FAISS index + embedding cache are generated from data/docs
data/embeddings/

#SERVER LOGS
server_err.log
server_out.log
server.log
dev-server.log
dev-server.err.log

# ENV — .env holds real secrets and is ignored; .env.example is the
# committed reference of supported variables and must be tracked.
.env

# MD FILES
md-files/

# Scratch scripts kept out of the repo
check_db.py
test_semantic.py

# Internal working notes and QA backlog. Private to the maintainer: these are
# planning documents (roadmap, session notes, runbook drafts), not product
# documentation, and nothing in app/, tests/ or CI reads them. The README is
# self-contained instead.
#
# Note: gitignoring does NOT untrack anything already committed. A fresh
# `git rm -r --cached markdowns docs` is required, and history still contains
# them until the history is rewritten.
markdowns/

# Project documentation set. Kept local for the same reason as markdowns/.
docs/

# Locust load-testing harness. Nothing in CI runs it, and the baseline report
# is a build artifact rather than source. Same untracking caveat as above.
load_tests/

# Local helper scripts. Deliberate exceptions below: the files CI invokes must
# stay tracked or the pipeline breaks on a missing path.
scripts/*
!scripts/e2e_postgres_worker.py   # CI postgres job
!scripts/notify_receiver.py       # CI postgres job
!scripts/seed_e2e_admin.py        # CI e2e job

# Generated documentation artifact
docs/AI-Customer-Support-Automation-Documentation.pdf

# Local credential scratch files
users.txt


# Uploaded ticket attachments (runtime data)
.uploads/

